# Fons — konfiguracja. Skopiuj do .env i uzupełnij. Plik .env nigdy nie trafia do repozytorium.

# --- Model językowy: OpenAI ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Rezydencja danych: "eu" kieruje ruch na eu.api.openai.com (wymaga projektu OpenAI z rezydencją w UE).
# Puste = przetwarzanie w USA (ujawniane w raportach).
OPENAI_DATA_RESIDENCY=


# Modele (puste = domyślne: główny gpt-6.2-sol, szybki gpt-6-luna)
MODEL_MAIN=
MODEL_FAST=

# Analiza publicznych filmów z TikToka i Instagrama. Po ustawieniu klucza
# serwer wysyła obraz i dźwięk do Gemini. Twierdzenia sprawdza zwykły silnik Fons.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
# Opcjonalny dostawca pliku dla publicznych filmów TikTok. Puste = pobieranie bezpośrednie.
SOCIALKIT_API_KEY=

# --- Opcjonalnie: drugi dostawca jako weryfikator z innej rodziny modeli (PLAN §3.6) ---
# Bez tego działa tryb jednego klucza (weryfikator = szybki model tego samego dostawcy, siła max „średnia”).
# Obsługiwani dostawcy: openai, anthropic, mistral (Mistral: endpoint UE).
# VERIFIER_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# Tryb werdyktu: rules (domyślny, reguły w kodzie) albo model_proposed (propozycja modelu + bramki kodu)
# VERDICT_MODE=rules
# Webhook odbiorcy alertów pętli informacji (puste = alerty tylko rekomendowane)
# ALERT_WEBHOOK_URL=

# --- Serwer ---
PORT=8787
# Publiczny adres usługi (linki do wyników, webhooki)
PUBLIC_BASE_URL=http://localhost:8787
# Plik bazy SQLite
DB_PATH=var/prawdowid.db

# --- Bezpieczeństwo i prywatność ---
# Hasło startowe konta „admin” (rola administrator), użyte tylko gdy plik użytkowników jest pusty.
# Puste = wygenerowane przy pierwszym starcie (zapisane w var/admin-password, wypisane raz na stderr).
ADMIN_PASSWORD=
# Plik kont panelu (moderator / analityk / administrator); zarządzanie: npm run user -- add|list|remove|passwd
USERS_PATH=var/users.json
# Opcjonalny statyczny token do GET /metrics (Prometheus); działają też tokeny API analityka z panelu
METRICS_TOKEN=
# Klucz HMAC do pseudonimizacji identyfikatorów użytkowników (puste = wygenerowany i zapisany w var/)
USER_ID_PEPPER=
# Dobowy bezpiecznik budżetu tokenów (wejście + wyjście, wszystkie wywołania)
DAILY_TOKEN_BUDGET=3000000
# Limit zapytań na użytkownika / IP na minutę
RATE_LIMIT_PER_MINUTE=10

# --- Wyszukiwanie na żywo w domenach z katalogu (opcjonalne) ---
# on = gałąź „live”: wyszukiwanie OpenAI web_search ograniczone do hostów z katalogu, pobranie stron przez filtr
# SSRF i detektor wstrzyknięć; ok. 0,02–0,04 USD i 4–7 s na twierdzenie (wymaga OPENAI_API_KEY).
#      Włącza też gałąź „official”: oficjalne kanały instytucji (MSZ Odyseusz, komunikaty RCB/MSZ na gov.pl)
#      pobierane bezpośrednio, bez klucza i bez kosztu (docs/TOOLS.md §1a). off = tylko zamknięty korpus.
LIVE_SEARCH=on

# --- Diagnostyka ---
# LOG_LEVEL=debug  (np. jedna linia na decyzję routera modeli, bez promptów i kluczy)

# --- Google Cloud: wyszukiwanie wystąpień obrazu i powiązanych fact-checków ---
# Fons dobiera wyszukiwanie do pytania. Klucz włącza Cloud Vision. Ustaw off, aby wyłączyć tę usługę.
# REVERSE_IMAGE_PROVIDER=off
GOOGLE_VISION_API_KEY=
REVERSE_IMAGE_DAILY_CAP=500
# Fact Check Tools API wyszukuje recenzje na podstawie publicznego URL dokładnego dopasowania z Vision.
# Klucz z console.cloud.google.com → APIs & Services → Credentials, ograniczony do Fact Check Tools API (i Cloud Vision API).
# Używa go `npm run corpus:demagog`: fact-checki Demagoga pobieramy WYŁĄCZNIE przez to API (bez łączenia się z demagog.org.pl).
# Bez klucza ingestor Demagoga nic nie pobiera, a istniejący data/corpus/demagog.jsonl zostaje bez zmian. Usługa działa bez klucza.
FACTCHECK_API_KEY=
# Okno czasowe fact-checków Demagoga w dniach (domyślnie 365; szersze okno zwiększa udział Demagoga w wynikach wyszukiwania).
# DEMAGOG_MAX_AGE_DAYS=365

# --- Opcjonalnie: import przypadków dezinformacji z EUvsDisinfo MCP ---
# Klucz dostępu EUvsDisinfo do https://mcp.euvsd.info/mcp. Pusty = import korzysta z publicznego wykazu HTML.
# Użycie: npm run corpus:build -- --only euvsdisinfo [--limit 2000]
EUVSDISINFO_MCP_TOKEN=
