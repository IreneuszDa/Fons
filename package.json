{
  "name": "fons",
  "version": "0.1.0",
  "scripts": {
    "setup:video": "python3 -m venv .cache/video-tools && .cache/video-tools/bin/python -m pip install yt-dlp==2026.10.26",
    "dev": "concurrently -n api,web \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "preview": "vite preview --port 4173",
    "corpus:build": "tsx src/corpus/build.ts",
    "corpus:load": "tsx src/corpus/load.ts",
    "corpus:officials": "tsx src/corpus/build.ts --only gov-pl-officials,sejm-mp,state-officials,eu-leadership,nato",
    "corpus:demagog": "tsx src/corpus/build.ts --only demagog",
    "corpus:verify": "tsx src/corpus/verify.ts",
    "embed": "tsx src/engine/retrieval/embed-corpus.ts",
    "ask": "tsx scripts/ask.ts",
    "user": "tsx scripts/user.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "live:smoke": "tsx src/tools/smoke.ts",
    "eval": "tsx eval/run.ts",
    "eval:redteam": "tsx eval/run.ts --suite redteam",
    "eval:demo": "tsx eval/run.ts --suite demo",
    "eval:render": "tsx eval/render.ts",
    "consistency": "tsx eval/consistency.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IreneuszDa/Fons.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IreneuszDa/Fons/issues"
  },
  "homepage": "https://github.com/IreneuszDa/Fons#readme",
  "description": "Fons — obywatelska weryfikacja informacji u źródła (HackNation 2026, zadanie MSZ)",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@astryxdesign/cli": "^0.7.17",
    "@astryxdesign/core": "^0.7.17",
    "@astryxdesign/theme-neutral": "^0.7.17",
    "@contentauth/c2pa-node": "0.12.1",
    "@heroicons/react": "^2.2.0",
    "@hono/node-server": "^2.1.11",
    "@huggingface/transformers": "^4.3.2",
    "@mistralai/mistralai": "^3.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@stylexjs/stylex": "^0.19.2",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "fastest-levenshtein": "^1.0.16",
    "hono": "^4.13.19",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "6.0.0",
    "sharp": "^0.35.5",
    "undici": "^7.30.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
